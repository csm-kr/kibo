# Copy to .env (git-ignored) and fill in what you need. Names only here; never commit a real value.
# Every variable is optional for `npm run dev`: without a key, voice answers with an error and typing falls back to
# Vertex AI (needs `gcloud auth application-default login`). Full table: docs/ARCHITECTURE.md "Environment variables".

# Gemini API key (https://aistudio.google.com/apikey). Voice (ephemeral tokens) and the text agent use it.
GEMINI_API_KEY=

# Text agent backend: auto (key first, Vertex AI on 402, 429 or 5xx), api (key only) or vertex (Vertex AI only).
GEMINI_TEXT_BACKEND=auto
# Vertex AI location for the text agent.
GEMINI_VERTEX_LOCATION=global
# Google Cloud project for Vertex AI and Firestore.
GOOGLE_CLOUD_PROJECT=
# Model ids (ADR-011).
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
# Text agent thinking level: low, medium or high.
GEMINI_TEXT_THINKING=low

# Voice path: auto (direct on the key, the relay when the key cannot pay), api (direct only) or vertex (relay only).
GEMINI_LIVE_BACKEND=auto
# The kibo-voice relay's wss://<host>/ws (ws://localhost:<port>/ws locally). Unset: voice stays direct.
VOICE_RELAY_URL=
# Vertex AI location for the relay (kibo-voice only).
VOICE_VERTEX_LOCATION=us-central1

# Session store: memory (default outside production; one process only) or firestore.
STORE=memory
# Allows STORE=memory in a production build (single instance only).
ALLOW_MEMORY_STORE=

# Origin in QR claim links; unset locally uses the request's host.
PUBLIC_ORIGIN=
# Short bare host the kiosk shows beside the pairing code, e.g. kibo-2026.web.app.
SHORT_APP_URL=
