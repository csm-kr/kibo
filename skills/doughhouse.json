  "recipes": {
    "startOrder": [
      {
        "op": "click",
        "label": "화면을 터치하여 주문을 시작하세요"
      },
      {
        "op": "click",
        "label": "{dineOption}"
      }
    ],
    "addToCart": [
      {
        "op": "click",
        "label": "{category}"
      },
      {
        "op": "click",
        "label": "{item}"
      },
      {
        "op": "forEach",
        "over": "options",
        "as": "option",
        "steps": [
          {
            "op": "clickIfVisible",
            "role": "radio",
            "name": "{option}"
          },
          {
            "op": "clickIfVisible",
            "role": "checkbox",
            "name": "{option}"
          }
        ]
      },
      {
        "op": "repeat",
        "times": "{qtyMinus1}",
        "steps": [
          {
            "op": "click",
            "label": "+"
          }
        ]
      },
      {
        "op": "click",
        "label": "장바구니 담기"
      },
      {
        "op": "clickIfVisible",
        "label": "아니요, 괜찮아요"
      }
    ],
    "removeLine": [
      {
        "op": "clickNth",
        "label": "삭제",
        "index": "{lineIndex}"
      }
    ]
  },
  "cartTotalPattern": "합계\\s*([0-9,]+)원",
  "cartLinePattern": "^(.+?)(?: \\((.+)\\))? x(\\d+) ([0-9,]+)원"
