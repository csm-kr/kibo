  "promotions": [
    {
      "rule": "Drink + snack set: offered in a 3-step modal after every drink is added (담기). Snack choices 펑리수, 누가크래커, 대만 카스테라 (에그타르트 shown sold out; 지파이 not offered)",
      "effect": "-800원 per set. Set unit price = drink price with its options + snack price - 800; line total = set unit x quantity (quantity comes from the option modal, the set shares it)"
    },
    {
      "rule": "Take-out (포장) order type",
      "effect": "+200원 disposable-cup fee per drink cup (sum of drink line quantities, set drinks included; snacks add nothing). Shown on the take-out card of the order-type screen, in the menu header badge, as '포장컵 비용 (N잔)' in the cart summary and as '포장컵 비용 (N잔 × 200원)' on the review; included in 총 결제 금액 and in the payment-screen amount. Switching to 매장 식사 on the review removes it"
    },
    {
      "rule": "Stamp card popup (once per session after the first item is added)",
      "effect": "No price effect. 1 stamp per drink, 10 stamps = one free M drink (not redeemable on this kiosk); an entered number is shown masked on the review screen"
    }
  ],
