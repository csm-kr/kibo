  "recipes": {
    "startOrder": [
      {
        "op": "click",
        "text": "{dineOption}"
      }
    ],
    "addToCart": [
      {
        "op": "click",
        "label": "{category}"
      },
      {
        "op": "click",
        "label": "{item}"
      },
      {
        "op": "chooseOptions",
        "steps": [
          {
            "op": "click",
            "label": "{option}"
          }
        ]
      },
      {
        "op": "repeat",
        "times": "{qtyMinus1}",
        "steps": [
          {
            "op": "click",
            "label": "+",
            "within": "수량"
          }
        ]
      },
      {
        "op": "click",
        "label": "주문 담기"
      }
    ],
    "meatRecipe": [
      {
        "op": "click",
        "label": "{category}"
      },
      {
        "op": "click",
        "label": "{item}"
      },
      {
        "op": "repeat",
        "times": "{qtyMinus1}",
        "steps": [
          {
            "op": "click",
            "label": "+",
            "within": "인분"
          }
        ]
      },
      {
        "op": "click",
        "label": "주문 담기"
      }
    ],
    "directRecipe": [
      {
        "op": "click",
        "label": "{category}"
      },
      {
        "op": "click",
        "label": "{item}"
      },
      {
        "op": "clickIfVisible",
        "label": "예"
      },
      {
        "op": "repeat",
        "times": "{qtyMinus1}",
        "steps": [
          {
            "op": "click",
            "label": "+",
            "within": "{item}"
          }
        ]
      }
    ]
  },
  "cartTotalPattern": "주문 금액[\\s\\S]*?strong: ([0-9,]+)원",
  "review": {
    "open": [
      {
        "op": "openReview",
        "label": "주문하기"
      }
    ],
    "totalPattern": "주문 금액[\\s\\S]*?strong: ([0-9,]+)원",
    "close": [
      {
        "op": "click",
        "label": "돌아가기"
      }
    ]
  },
  "interrupts": [
    {
      "text": "만 19세 이상이십니까?",
      "dismiss": {
        "op": "click",
        "label": "예"
      }
    }
  ],
  "notes": [
    "테이블 오더 키오스크로 결제는 카운터에서 진행됨",
