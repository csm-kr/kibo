  "recipes": {
    "startOrder": [
      {
        "op": "click",
        "label": "면구름 라멘"
      },
      {
        "op": "click",
        "label": "{dineOption}"
      }
    ],
    "addToCart": [
      {
        "op": "click",
        "label": "{category}"
      },
      {
        "op": "click",
        "label": "{item}"
      },
      {
        "op": "forEach",
        "over": "options",
        "as": "option",
        "steps": [
          {
            "op": "click",
            "label": "{option}"
          }
        ]
      },
      {
        "op": "clickIfVisible",
        "label": "담기"
      },
      {
        "op": "repeat",
        "times": "{qtyMinus1}",
        "steps": [
          {
            "op": "click",
            "label": "수량 더하기"
          }
        ]
      }
    ]
  },
  "notes": [
    "Dine-in / takeout choice at start screen",
    "Ramen requires noodle firmness choice",
    "Rice bowl has optional rice size (extra 1,000 won)",
    "Sides and drinks go directly to cart"
  ]
}