  "recipes": {
    "startOrder": [
      {
        "op": "click",
        "label": "별바다 파크"
      }
    ],
    "addToCart": [
      {
        "op": "click",
        "label": "{category}"
      },
      {
        "op": "click",
        "label": "{item}"
      },
      {
        "op": "chooseOptions",
        "steps": [
          {
            "op": "click",
            "label": "{option}"
          }
        ]
      },
      {
        "op": "repeat",
        "times": "{qtyMinus1}",
        "steps": [
          {
            "op": "click",
            "label": "+"
          }
        ]
      },
      {
        "op": "click",
        "label": "담기"
      }
    ],
    "ticket": [
      {
        "op": "click",
        "label": "{category}"
      },
      {
        "op": "click",
        "label": "{item}"
      },
      {
        "op": "chooseOptions",
        "steps": [
          {
            "op": "click",
            "label": "{option}"
          }
        ]
      },
      {
        "op": "click",
        "label": "담기"
      }
    ],
    "souvenir": [
      {
        "op": "click",
        "label": "{category}"
      },
      {
        "op": "click",
        "label": "{item}"
      },
      {
        "op": "repeat",
        "times": "{qtyMinus1}",
        "steps": [
          {
            "op": "click",
            "label": "{item}"
          }
        ]
      }
    ]
  },
  "cartTotalPattern": "합계\\s*([0-9,]+)원",
  "interrupts": [
    {
      "text": "회원이신가요?",
      "dismiss": {
        "op": "click",
        "label": "비회원으로 계속"
      }
    }
  ],
  "review": {
    "open": [
      {
        "op": "openReview",
        "label": "주문하기"
      }
    ],
    "totalPattern": "총 결제 금액\\s*([0-9,]+)원",
    "close": [
      {
        "op": "click",
        "label": "이전"
      }
    ]
  }
}