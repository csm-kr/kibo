{
  "kiosk": "모의 찻집",
  "categories": ["음료", "간식"],
  "uiLabels": ["🧾 주문 내역", "취소", "−", "+"],
  "forbiddenLabels": ["카드 결제"],
  "dineOptions": {},
  "catalog": [
    {
      "name": "녹차라떼", "category": "음료", "price": 4000, "soldOut": false,
      "optionGroups": [
        { "name": "크기", "required": true, "min": 1, "max": 1, "options": [{ "name": "R", "priceDelta": 0 }, { "name": "L", "priceDelta": 500 }] },
        { "name": "단맛", "required": true, "min": 1, "max": 1, "options": [{ "name": "0%", "priceDelta": 0 }, { "name": "50%", "priceDelta": 0 }, { "name": "100%", "priceDelta": 0 }] },
        { "name": "추가", "type": "multi", "required": false, "min": 0, "max": 2, "options": [{ "name": "펄", "priceDelta": 500 }, { "name": "젤리", "priceDelta": 500 }] },
        { "name": "세트", "required": true, "min": 1, "max": 1, "options": [{ "name": "음료만", "priceDelta": 0 }, { "name": "간식 세트", "priceDelta": -300 }] },
        { "name": "세트 간식", "required": true, "min": 1, "max": 1, "appliesWhen": "세트=간식 세트",
          "after": [{ "op": "click", "label": "다음" }, { "op": "click", "label": "세트 담기" }],
          "options": [{ "name": "쿠키", "priceDelta": 2000 }, { "name": "머핀", "priceDelta": 2500 }] }
      ]
    },
    {
      "name": "아이스티", "category": "음료", "price": 3500, "soldOut": false,
      "optionGroups": [
        { "name": "크기", "required": true, "min": 1, "max": 1, "options": [{ "name": "R", "priceDelta": 0 }, { "name": "L", "priceDelta": 500 }] },
        { "name": "단맛", "required": true, "min": 1, "max": 1, "options": [{ "name": "0%", "priceDelta": 0 }, { "name": "50%", "priceDelta": 0 }, { "name": "100%", "priceDelta": 0 }] },
        { "name": "추가", "type": "multi", "required": false, "min": 0, "max": 2, "options": [{ "name": "펄", "priceDelta": 500 }, { "name": "젤리", "priceDelta": 500 }] },
        { "name": "세트", "required": true, "min": 1, "max": 1, "options": [{ "name": "음료만", "priceDelta": 0 }, { "name": "간식 세트", "priceDelta": -300 }] },
        { "name": "세트 간식", "required": true, "min": 1, "max": 1, "appliesWhen": "세트=간식 세트",
          "after": [{ "op": "click", "label": "다음" }, { "op": "click", "label": "세트 담기" }],
          "options": [{ "name": "쿠키", "priceDelta": 2000 }, { "name": "머핀", "priceDelta": 2500 }] }
      ]
    },
    { "name": "쿠키", "category": "간식", "price": 2000, "soldOut": false, "optionGroups": [] },
    { "name": "머핀", "category": "간식", "price": 2500, "soldOut": false, "optionGroups": [] }
  ],
  "recipes": {
    "startOrder": [{ "op": "click", "label": "주문 시작" }],
    "addToCart": [
      { "op": "click", "label": "{category}" },
      { "op": "click", "label": "{item}" },
      { "op": "chooseOptions", "steps": [{ "op": "click", "label": "{option}" }] },
      { "op": "repeat", "times": "{qtyMinus1}", "steps": [{ "op": "click", "label": "+", "within": "수량" }] },
      { "op": "click", "role": "button", "name": "담기" },
      { "op": "chooseOptions", "groups": ["세트", "세트 간식"], "steps": [{ "op": "click", "label": "{option}" }] }
    ]
  },
  "interrupts": [{ "text": "포인트를 적립할까요?", "dismiss": { "op": "click", "label": "건너뛰기" } }],
  "cartTotalPattern": "합계 ([\\d,]+)원",
  "notes": ["단맛 is required and has no default. After 담기 a drink asks for a snack set: 음료만 adds it, 간식 세트 asks for the snack, 다음, then 세트 담기."]
}
