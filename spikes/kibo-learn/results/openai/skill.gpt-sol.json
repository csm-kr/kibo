  "recipes": {
    "startOrder": [
      {
        "op": "click",
        "label": "화면을 터치하여 주문을 시작하세요"
      },
      {
        "op": "click",
        "label": "{dineOption}"
      }
    ],
    "addToCart": [
      {
        "op": "click",
        "label": "{category}"
      },
      {
        "op": "click",
        "label": "{item}"
      },
      {
        "op": "forEach",
        "over": "options",
        "as": "option",
        "steps": [
          {
            "op": "click",
            "label": "{option}",
            "exact": true
          }
        ]
      },
      {
        "op": "repeat",
        "times": "{qtyMinus1}",
        "steps": [
          {
            "op": "click",
            "label": "+"
          }
        ]
      },
      {
        "op": "click",
        "label": "장바구니 담기"
      },
      {
        "op": "clickIfVisible",
        "label": "아니요, 괜찮아요"
      }
    ],
    "checkoutEntry": [
      {
        "op": "click",
        "label": "주문하기"
      }
    ]
  },
  "cartTotalPattern": "합계 ([0-9,]+)원",
  "notes": [
    "Required groups start unselected; include one size and dough for pizza, one volume for drinks.",
    "Pizza topping group permits at most three selections.",
    "Pizza upsell recommends garlic dip; dismiss 아니요, 괜찮아요 rather than adding an unrequested side.",
    "포테이토 피자 is sold out and cannot be opened; its options are unknown.",
    "Checkout entry opens 결제 방법을 선택하세요 with 💳 신용/체크카드; recipes stop at cart unless checkoutEntry is invoked."
  ]
