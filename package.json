{
  "name": "kibo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:live": "E2E_LIVE=1 playwright test --grep @live",
    "test:firestore": "FIRESTORE_IT=1 STORE=firestore vitest run src/lib/store/firestore.it.test.ts",
    "qa:ui": "playwright test -c playwright.qa.config.ts",
    "eval:agent": "tsx --env-file=.env scripts/eval-agent.ts",
    "measure:cost": "tsx --env-file=.env scripts/measure-cost.ts",
    "load:check": "tsx --env-file=.env scripts/load-check.ts",
    "lighthouse": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/lighthouse.ts",
    "pwa:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/pwa-check.ts",
    "fixtures:voice": "tsx --env-file=.env scripts/make-voice-fixtures.ts",
    "shots:landing": "tsx scripts/landing-shots.ts",
    "shots:deck": "tsx --env-file=.env scripts/deck-shots.ts",
    "capture:footage": "tsx --env-file=.env scripts/capture-footage.ts",
    "voice:build": "esbuild voice-relay/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=voice-relay/dist/server.cjs --external:firebase-admin --external:'firebase-admin/*' --external:bufferutil --external:utf-8-validate --log-level=warning",
    "voice:relay-check": "npm run voice:build && tsx --env-file=.env scripts/voice-relay-check.ts",
    "grade:blind": "node spikes/blind-kiosks/grade/grade.mjs",
    "learn:runs": "tsx scripts/learn-runs.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "firebase-admin": "^14.5.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
